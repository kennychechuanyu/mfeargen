^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^\.git$
^\.gitignore$
^LICENSE\.md$
^README\.Rmd$
^cran-comments\.md$
^NEWS\.md$
^CRAN-SUBMISSION\.md$
^_pkgdown\.yml$
^docs$
^pkgdown$
^codecov\.yml$
^\.travis\.yml$
^appveyor\.yml$
^\.Rhistory$
^\.RData$
^\.DS_Store$
